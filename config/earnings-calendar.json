    "tiedToNewsUpdates": true,
    "dailySlots": [
      "09:00",
      "16:00",
      "21:00"
    ],
    "reviewResultsDuringNewsUpdate": true,
    "mondayIncludesWeekendNews": true,
    "notes": "挂在每日讯息更新上：可轻量刷新三周日历；结果核验仅增量（已知已披露且未评价）。周一须覆盖上周六日讯息。"
  },
  "resultReview": {
    "mode": "incremental",
    "onlyKnownReportedAndUnreviewed": true,
    "skipAlreadyScoredWithoutNewEvidence": true,
    "notes": "日常更新不对整周做重复结果检索；只查已知已披露且尚未评价的公司。"
  },
  "resultScore": {
    "scale": "0-100",
    "bands": [
      {
        "id": "miss",
        "label": "不及预期",
        "min": 0,
        "maxExclusive": 60
      },
      {
        "id": "inline",
        "label": "符合预期",
        "min": 60,
        "maxExclusive": 70
      },
      {
        "id": "beat",
        "label": "超预期",
        "min": 70,
        "maxExclusive": 90
      },
      {
        "id": "smash",
        "label": "远超预期",
        "min": 90,
        "maxInclusive": 100
      }
    ],
    "unknownAllowed": true,
    "notTradingAdvice": true
  }
