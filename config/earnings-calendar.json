{
  "version": 1,
  "timezone": "Asia/Shanghai",
  "source": {
    "id": "nasdaq-calendar-earnings",
    "name": "Nasdaq Earnings Calendar",
    "endpoint": "https://api.nasdaq.com/api/calendar/earnings",
    "notes": "稳定主源。按交易日查询；请求需浏览器 UA、Origin、Referer。X 仅可选核对。筛选核心见 selectionCore 与 docs/EARNINGS_CALENDAR.md。"
  },
  "important": {
    "minMarketCapUsd": 50000000000,
    "maxPerDay": 12,
    "alwaysInclude": [
      "NVDA",
      "TSLA",
      "AAPL",
      "MSFT",
      "META",
      "GOOGL",
      "AMZN",
      "AVGO",
      "TSM",
      "ASML"
    ],
    "role": "辅助种子与粗筛，不能替代主题池与自主判断"
  },
  "displayDays": 5,
  "selectionCore": {
    "adoptedAt": "2026-10-12",
    "summary": "必看主题池 + 自主判断；不是仅市值或仅死名单",
    "mustCoverThemes": [
      "AI半导体",
      "电力",
      "软件",
      "老牛股/质量股",
      "新兴科技"
    ],
    "autonomousJudgment": true,
    "fixedListIsNotSystemOfRecord": true,
    "docs": "docs/EARNINGS_CALENDAR.md"
  },
  "refresh": {
    "timezone": "Asia/Shanghai",
    "dailySlots": [
      "09:00",
      "16:00",
      "21:00"
    ],
    "sundayPreview": true,
    "withNewsUpdateReviewResults": true,
    "notes": "与美股讯息同窗口刷新日历；每次讯息更新须回看已披露结果；周日晚预览下周。"
  },
  "resultScore": {
    "scale": "0-100",
    "bands": [
      {
        "id": "miss",
        "label": "不及预期",
        "min": 0,
        "maxExclusive": 60
      },
      {
        "id": "inline",
        "label": "符合预期",
        "min": 60,
        "maxExclusive": 70
      },
      {
        "id": "beat",
        "label": "超预期",
        "min": 70,
        "maxExclusive": 90
      },
      {
        "id": "smash",
        "label": "远超预期",
        "min": 90,
        "maxInclusive": 100
      }
    ],
    "unknownAllowed": true,
    "notTradingAdvice": true
  }
}
