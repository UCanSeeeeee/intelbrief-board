{
  "name": "intelbrief-board",
  "version": "1.0.0",
  "private": true,
  "description": "Auditable X-only intelligence dashboard with explainable credibility scoring",
  "scripts": {
    "fetch": "node scripts/fetch-x.js && node scripts/build-intelligence.js",
    "fetch:x": "node scripts/fetch-x.js",
    "import:x": "node scripts/import-x.js",
    "score": "node scripts/build-intelligence.js",
    "build": "node scripts/build-site.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/validate-data.js",
    "brief:slot": "node scripts/stock-brief.js slot",
    "brief:validate": "node scripts/stock-brief.js validate",
    "brief:publish": "node scripts/stock-brief.js publish",
    "dev": "npx --yes serve -l 8787 .",
    "pages:dev": "npm run build && wrangler pages dev dist --port 8787",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=intelbrief-board",
    "updates:setup": "node scripts/setup-updates.js",
    "updates:start": "node scripts/update-runner.js",
    "updates:schedule": "node scripts/schedule-update.js",
    "dev:updates": "node scripts/local-updates.js",
    "fetch:earnings": "node scripts/fetch-earnings.js",
    "macro:refresh": "node scripts/refresh-macro-events.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
