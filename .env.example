# Copy to .env and fill in. Never commit .env.
# Default MODE=placeholder works with zero API keys.

# placeholder | live
# placeholder: scripts write demo JSON under data/
# live: scripts call external APIs (requires keys below)
MODE=placeholder

# Optional — only used when MODE=live
# X / Twitter API (celebrity posts). Leave empty in placeholder mode.
X_BEARER_TOKEN=

# Optional news / market intel provider for stock session digests
# Example: NewsAPI, Finnhub, Polygon — pick one and wire in scripts/fetch-stock-sessions.js
STOCK_NEWS_API_KEY=
STOCK_NEWS_API_BASE=https://example.com/v1

# Comma-separated tickers included in every session digest
WATCHLIST=NVDA,TSLA,AAPL,MSFT,META

# Timezone for timestamps written into JSON (IANA)
TZ=Asia/Shanghai

# Cloudflare (only for CLI deploy: npm run deploy)
# Create token at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Public site URL after Pages deploy (docs / absolute links). No trailing slash.
# Example: https://intelbrief-board.pages.dev
SITE_URL=
