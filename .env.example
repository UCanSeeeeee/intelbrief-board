# Copy to .env and fill in. Never commit .env or paste the token into chat.
# Official X API bearer token. Required by `npm run fetch`.
X_BEARER_TOKEN=

# Per account. X API accepts 5-100 for user timelines.
X_MAX_RESULTS=20
# Ignore older posts when rebuilding the display dataset.
X_LOOKBACK_HOURS=168
# Optional comma-separated cashtags added to the configured search query.
WATCHLIST=NVDA,TSLA,AAPL,MSFT,META,GOOGL,AVGO
TZ=Asia/Shanghai

# Cloudflare (only for CLI deploy: npm run deploy)
# Create token at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Public site URL after Pages deploy (docs / absolute links). No trailing slash.
# Example: https://intelbrief-board.pages.dev
SITE_URL=
